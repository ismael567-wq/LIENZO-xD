{
  "name": "lienzo",
  "private": true,
  "version": "1.2.1",
  "description": "Lienzo — pizarra visual colaborativa local-first para web, escritorio y móvil.",
  "author": "Lienzo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismael567-wq/LIENZO-xD.git"
  },
  "homepage": "https://github.com/ismael567-wq/LIENZO-xD",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --configLoader native",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview --configLoader native --host 0.0.0.0",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native --pool=threads",
    "test:watch": "vitest --configLoader native --pool=threads",
    "desktop": "npm run build && npm run build:server && node scripts/desktop.mjs",
    "desktop:dist": "npm run build && npm run build:server && electron-builder --win zip",
    "desktop:installer": "npm run build && npm run build:server && electron-builder --config electron-builder.installer.json --win nsis",
    "desktop:portable": "npm run build && npm run build:server && electron-builder --config electron-builder.installer.json --win portable",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "nanoid": "^6.0.2",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "app.lienzo.desktop",
    "productName": "Lienzo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "server-dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "server-dist/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Lienzo-${version}-portable.exe"
    },
    "electronLanguages": [
      "es",
      "en-US"
    ]
  }
}
