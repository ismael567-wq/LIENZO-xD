{
  "appId": "app.tiza.desktop",
  "productName": "tiza",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/**/*",
    "server-dist/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "server/**/*",
    "server-dist/**/*"
  ],
  "npmRebuild": false,
  "compression": "normal",
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.ico"
  },
  "portable": {
    "artifactName": "tiza-${version}-portable.exe"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "tiza",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "tiza-Setup-${version}.exe",
    "license": "LICENSE",
    "include": "build/installer.nsh"
  }
}
